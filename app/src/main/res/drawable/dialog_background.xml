<?xml version="1.0" encoding="utf-8"?>
<!--
  终端列表型弹窗的容器（方案 B）。

  为什么需要它：AppCompat 的 AlertDialog 默认背景是方角 + 无描边，在圆表盘上
  「像安卓原生的一样」。这里给弹窗一个自带圆角/描边的背景。

  为什么用 <shape> 而不是 MaterialCardView：
  AlertDialog 的 window 背景就吃这个 drawable，套 CardView 会多一层裁剪与测量；
  且 setBackgroundDrawable 对 dialog window 是最省事的做法。

  颜色一律走 ?attr/（由各主题的 alertDialogTheme overlay 提供），
  所以 7 套主题各有各的底色/描边，不需要为每套主题抄一个布局。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurface" />

    <stroke
        android:width="1dp"
        android:color="?attr/colorPrimary" />

    <corners android:radius="@dimen/card_round" />

</shape>
