<?xml version="1.0" encoding="utf-8"?>
<!--
  反馈与建议（26.10.09 新增）。

  与上游完全独立的一条反馈通道：内容直接 POST 到本项目自建服务器
  （server/rebiliterminal_api.py，见 TerminalApi.BASE_URL），
  不经过 B 站接口、不需要登录。

  全部控件都用工程里已有的样式（background_edittext / MaterialCardView / RotaryScrollView），
  没有引入新的 drawable 或主题属性 —— 手表端 7 套主题都要成立。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.FeedbackActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_feedback"
            android:textStyle="bold" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginVertical="3dp"
            android:layout_marginEnd="8dp" />

    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/feedback_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_privacy"
                android:textSize="10sp"
                android:alpha="0.8"
                android:paddingHorizontal="4dp"
                android:paddingBottom="4dp" />

            <!-- 反馈类型：点开是 TerminalDialog.singleChoice -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/category_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/category_text"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:textSize="13sp"
                    tools:text="功能异常" />

            </com.google.android.material.card.MaterialCardView>

            <EditText
                android:id="@+id/content_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_edittext"
                android:gravity="top|start"
                android:hint="@string/feedback_content_hint"
                android:inputType="textMultiLine"
                android:minHeight="80dp"
                android:padding="8dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/content_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingHorizontal="4dp"
                android:paddingTop="2dp"
                android:alpha="0.7"
                android:textSize="10sp"
                tools:text="0 / 4000" />

            <EditText
                android:id="@+id/contact_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_edittext"
                android:hint="@string/feedback_contact_hint"
                android:inputType="text"
                android:maxLines="1"
                android:padding="8dp"
                android:textSize="13sp" />

            <!-- 是否附带账号 ID：默认关，见 SettingsKeys.FEEDBACK_ATTACH_MID -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/attach_mid_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/attach_mid_text"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:textSize="13sp" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submit_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/feedback_submit"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/submit_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:alpha="0.85"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="已收到，反馈编号：12" />

        </LinearLayout>

    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</RelativeLayout>
